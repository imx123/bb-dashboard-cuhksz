{
  "name": "bb-dashboard-cuhksz",
  "version": "0.1.0",
  "description": "CUHK-Shenzhen Blackboard Classic Dashboard for courses, announcements, assignments and resources",
  "type": "module",
  "license": "MIT",
  "author": "imx123",
  "homepage": "https://github.com/imx123/bb-dashboard-cuhksz#readme",
  "repository": { "type": "git", "url": "git+https://github.com/imx123/bb-dashboard-cuhksz.git" },
  "bugs": { "url": "https://github.com/imx123/bb-dashboard-cuhksz/issues" },
  "keywords": ["cuhksz", "blackboard", "dashboard", "education", "electron"],
  "engines": { "node": ">=22.16.0" },
  "main": "dist/src/dashboard/main.js",
  "files": ["bin", "dist", "plugins/lms-cli", "scripts/start-dashboard.mjs", "scripts/launchers", "vendor/*/LICENSE", "README.md", "THIRD_PARTY_NOTICES.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "start": "node scripts/start-dashboard.mjs",
    "start:dashboard": "node scripts/start-dashboard.mjs",
    "start:dashboard:fixture": "node scripts/start-dashboard.mjs --fixture",
    "pack:cli": "npm run build && npm pack",
    "pack:standalone": "npm run build && node scripts/pack-standalone.mjs",
    "pack:app:release": "npm run build && node scripts/pack-macos-app.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "verify:auth": "electron scripts/verify-login-preload.mjs && electron scripts/verify-adfs-preload.mjs && electron scripts/verify-auth-flow.mjs && electron scripts/verify-auth-ui.mjs",
    "pack:app": "npm run build && electron-builder --publish never",
    "pack:app:win": "npm run build && node scripts/pack-windows-app.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.0",
    "ajv": "8.20.0",
    "commander": "14.0.3",
    "ical-generator": "10.0.0",
    "proper-lockfile": "4.1.2",
    "sanitize-html": "^2.18.0",
    "tar": "7.5.22",
    "tough-cookie": "5.1.2",
    "unpdf": "1.8.1",
    "zod": "3.25.76"
  },
  "optionalDependencies": { "electron": "44.4.3" },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@types/node": "24.5.2",
    "@types/proper-lockfile": "4.1.4",
    "electron-builder": "26.15.3",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  },
  "build": {
    "appId": "io.github.imx123.bb-dashboard-cuhksz",
    "productName": "bb-dashboard-cuhksz",
    "icon": "assets/lms-icon.png",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md", "vendor/*/LICENSE"],
    "asarUnpack": ["**/*.node"],
    "npmRebuild": false,
    "mac": { "category": "public.app-category.education", "hardenedRuntime": true, "gatekeeperAssess": false, "icon": "assets/lms-icon.png", "target": ["dmg", "zip"] },
    "win": { "icon": "assets/lms-icon.png", "target": ["nsis"], "artifactName": "bb-dashboard-cuhksz-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": true, "allowElevation": true, "allowToChangeInstallationDirectory": true },
    "linux": { "icon": "assets/lms-icon.png", "target": ["AppImage"], "category": "Education" }
  }
}
